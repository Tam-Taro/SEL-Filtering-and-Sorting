[
  {
    "expression": "/*ISE v2.0* [git.tamtaro.de]*/[]",
    "enabled": true
  },
  {
    "expression": "/*SeaDex*/count(addon(cached(streams),'SeaDex'))>0?passthrough(addon(streams,'SeaDex'),'title','year'):passthrough(seadex(streams),'title','year')",
    "enabled": true
  },
  {
    "expression": "/*Library*/count(streams)==count(library(streams))?library(streams):[]",
    "enabled": true
  },
  {
    "expression": "/*0Cached*/ count(merge(cached(streams), type(streams, 'p2p','http','usenet','stremio-usenet')))==0?passthrough(streams,'title'):[]",
    "enabled": true
  }
]